{
  "manifest_version": 2,
  "version": "0.2.0",
  "name": "WeMai Adapter 微信适配器",
  "description": "MaiBot 的微信个人号适配器插件（OneBot v11 WS 客户端）：作为协议适配层，在 MaiBot 与微信桥接服务之间转发私聊/群聊消息。仅用于个人学习与研究。",
  "author": {
    "name": "jessiongod",
    "url": "https://github.com/jessiongod"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/jessiongod/wemai-adapter",
    "homepage": "https://github.com/jessiongod/wemai-adapter",
    "documentation": "https://github.com/jessiongod/wemai-adapter/blob/master/README.md",
    "issues": "https://github.com/jessiongod/wemai-adapter/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "websockets",
      "version_spec": ">=12.0"
    }
  ],
  "capabilities": [
    "platform:duplex",
    "platform:receive",
    "platform:send"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "id": "github.jessiongod.wemai-adapter",
  "plugin_type": "adapter"
}
